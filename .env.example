# Google Gemini — powers the smile analysis
GEMINI_API_KEY=

# Resend (resend.com) — sends lead notification emails to clinics.
# If unset, leads are logged to the server console instead of emailed.
RESEND_API_KEY=

# Verified sender for lead emails, e.g. "SmileFlow <leads@yourdomain.com>".
# Without a verified domain, Resend only allows "onboarding@resend.dev".
LEAD_FROM_EMAIL=

# Your address — BCC'd on every lead so you see all activity across clinics.
LEAD_BCC_EMAIL=

# The production site URL, used for canonical tags, sitemap, robots.txt, and OG images.
NEXT_PUBLIC_SITE_URL=https://getsmileflow.com

# Stripe — powers the post-payment welcome email.
# Secret key from Stripe Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=

# Signing secret from Stripe Dashboard > Developers > Webhooks, after adding an
# endpoint pointing to https://getsmileflow.com/api/stripe-webhook listening for
# the "checkout.session.completed" event.
STRIPE_WEBHOOK_SECRET=

# Google Gemini — powers the smile analysis
GEMINI_API_KEY=

# Resend (resend.com) — sends lead notification emails to clinics.
# If unset, leads are logged to the server console instead of emailed.
RESEND_API_KEY=

# Verified sender for lead emails, e.g. "SmileFlow <leads@yourdomain.com>".
# Without a verified domain, Resend only allows "onboarding@resend.dev".
LEAD_FROM_EMAIL=

# Your address — BCC'd on every lead so you see all activity across clinics.
LEAD_BCC_EMAIL=
